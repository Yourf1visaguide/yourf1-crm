enum WhatsAppConversationStatus {
  OPEN
  PENDING
  CLOSED
}

model WhatsAppConversation {
  id String @id @default(cuid())

  // WhatsApp contact information
  contactWaId   String
  contactPhone  String
  contactName   String?

  status WhatsAppConversationStatus @default(OPEN)

  // CRM links
  clientId String?
  leadId   String?

  // Current routing
  assignedDepartment DEPARTMENT?
  assignedToId       String?
  assignedAt         DateTime?

  // SLA / response tracking
  slaDueAt        DateTime?
  firstResponseAt DateTime?
  slaBreachedAt   DateTime?

  // Conversation activity
  lastMessageAt       DateTime?
  lastInboundAt       DateTime?
  lastOutboundAt      DateTime?
  lastMessagePreview  String?

  closedAt   DateTime?
  closedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client? @relation( fields: [clientId], references: [id], onDelete: SetNull )

  lead Lead? @relation( fields: [leadId], references: [id], onDelete: SetNull )

  assignedTo User? @relation( "WhatsAppConversationAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull )

  closedBy User? @relation( "WhatsAppConversationClosedBy", fields: [closedById], references: [id], onDelete: SetNull )
  branchId String 
  branch Branch @relation( fields: [branchId], references: [id], onDelete: Restrict )
  messages WhatsAppMessage[]

  @@unique([contactWaId])
  @@index([status, lastMessageAt])
  @@index([assignedToId, status])
  @@index([assignedDepartment, status])
  @@index([clientId])
  @@index([leadId])
  @@index([slaDueAt])
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppMessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  LOCATION
  INTERACTIVE
  TEMPLATE
  OTHER
}

enum WhatsAppMessageStatus {
  RECEIVED
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model WhatsAppMessage {
  id String @id @default(cuid())

  conversationId String

  // ID supplied by WhatsApp/AiSensy
  externalMessageId String?

  direction WhatsAppMessageDirection
  type      WhatsAppMessageType
  status    WhatsAppMessageStatus @default(PENDING)

  body String?

  // Current media reference
  storageKey String?
  fileName   String?
  mimeType   String?

  // For automated/template messages
  templateName         String?
  providerCampaignName String?

  // Optional CRM business reference
  entityType String?
  entityId   String?

  // Prevent duplicate automated sends
  idempotencyKey String? @unique

  // Human sender; NULL for automated/system messages
  sentById String?

  // Provider timestamp
  messageAt DateTime @default(now())

  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  failedAt    DateTime?

  failureReason String?

  createdAt DateTime @default(now())

  conversation WhatsAppConversation @relation( fields: [conversationId], references: [id], onDelete: Cascade )

  sentBy User? @relation( "WhatsAppMessageSentBy", fields: [sentById], references: [id], onDelete: SetNull )

  @@unique([externalMessageId])
  @@index([conversationId, messageAt])
  @@index([conversationId, direction])
  @@index([status])
  @@index([sentById])
  @@index([entityType, entityId])
}


