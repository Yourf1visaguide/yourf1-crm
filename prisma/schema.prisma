// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}




model Branch {
  id String @id @default(cuid())

  branchCode String @unique
  name       String

  phone   String?
  email   String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // employees Employee[]

  leads              Lead[]
  registrations      Registration[]
  applications       Application[]
  invoices           Invoice[]
  expenses           Expense[]
  financialEntries   FinancialEntry[]
  whatsappConversations WhatsAppConversation[]
  tasks              Task[]
  // officeReports      OfficeDailyReport[]
  teachingEnrollments TeachingEnrollment[]
  employeeAttendance EmployeeAttendance[]
  payrollEntries     PayrollEntry[]
  clients Client[]

  @@index([isActive])
}


enum DEPARTMENT {
  ADMIN
  PARTNER
  RECEPTION
  TELECALLING
  COUNSELLING
  FILING
  TEACHING
  FINANCE
  MARKETING
  HR
}

enum ROLES {
  ADMIN
  RECEPTION
  TELECALLER
  COUNSELOR
  TEACHER
  FILING
  FINANCE
  MARKETING
  HR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  isActive Boolean @default(true)
  roles    ROLES[] @default([])

  employee      Employee?
  name          String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  username      String?

  sessions Session[]
  accounts Account[]

  officeReportsCreated OfficeDailyReport[] @relation("OfficeReportCreatedBy")

  leadAssignedTo LeadAssignment[] @relation("LeadAssignedTo")

  leadAssignedBy LeadAssignment[] @relation("LeadAssignedBy")

  registrations Registration[] @relation("RegistrationCreatedBy")

  registrationsCancelled Registration[] @relation("RegistrationCancelledBy")

  paymentsReceived Payment[] @relation("PaymentReceivedBy")

  refundsProcessed Refund[] @relation("RefundProcessedBy")

  tasksAssigned Task[] @relation("TaskAssignedTo")

  tasksCreated Task[] @relation("TaskCreatedBy")
  leadCallAttemptBy LeadCallAttempt[]
  notifications Notification[] @relation("NotificationUser")

  notificationsResolved Notification[] @relation("NotificationResolvedBy")

  auditLogs AuditLog[] @relation("AuditLogActor")

  applicationDocumentsUploaded ApplicationDocument[] @relation("ApplicationDocumentUploadedBy")
  expensesRecorded             Expense[]             @relation("ExpenseRecordedBy")
  expensesVoided               Expense[]             @relation("ExpenseVoidedBy")
  financialEntriesRecorded FinancialEntry[] @relation("FinancialEntryRecordedBy")
  financialEntriesVoided   FinancialEntry[] @relation("FinancialEntryVoidedBy")
  postVisaTasksCompleted PostVisaTask[] @relation("PostVisaTaskCompletedBy")

  whatsappConversationsAssigned WhatsAppConversation[]  @relation("WhatsAppConversationAssignedTo")

  whatsappConversationsClosed WhatsAppConversation[] @relation("WhatsAppConversationClosedBy")

  whatsappMessagesSent WhatsAppMessage[] @relation("WhatsAppMessageSentBy")

    teachingEnrollments TeachingEnrollment[] @relation("TeachingEnrollmentTeacher")

  teachingExamBookings TeachingEnrollment[] @relation("TeachingExamBookedBy")

  teachingDailyRecords TeachingDailyRecord[] @relation("TeachingDailyRecordRecordedBy")

  teacherDailyProgress TeacherDailyProgress[] @relation("TeacherDailyProgressTeacher")

   touristPrepsCompleted TouristPrep[] @relation("TouristPrepCompletedBy")
    touristPrepsCreated TouristPrep[] @relation("TouristPrepTeacher")

  employeeAttendancesRecorded EmployeeAttendance[] @relation("EmployeeAttendanceRecordedBy")

  salaryAdvancesRecorded EmployeeSalaryAdvance[] @relation("SalaryAdvanceRecordedBy")

  leadStatusHistoryChanged LeadStatusHistory[] @relation("LeadStatusHistoryChangedBy")
  leadVisitsCreated LeadVisit[] @relation("LeadVisitCreatedBy")
leadVisitEvents   LeadVisitEvent[] @relation("LeadVisitEventChangedBy")
  @@unique([username])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Employee {
  id               String           @id @default(cuid())
  employeeCode     String           @unique
  department       DEPARTMENT
  designation      String?
  joiningDate      DateTime         @db.Date
  employmentStatus EmploymentStatus @default(ACTIVE)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  
  compensation   EmployeeCompensation[]
  schedules      EmployeeWorkSchedule[]
  payrollEntries PayrollEntry[] 
  commissions    CommissionEntry[]
  attendanceRecords EmployeeAttendance[]
  salaryAdvances   EmployeeSalaryAdvance[]
}

model EmployeeCompensation {
  id            String    @id @default(cuid())
  employeeId    String
  monthlySalary Decimal   @db.Decimal(12, 2)
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, effectiveFrom])
}

model EmployeeWorkSchedule {
  id            String    @id @default(cuid())
  employeeId    String
  startTime     String
  endTime       String
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, effectiveFrom])
}

// employe salary calculation table.

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}
model PayrollEntry {
  id           String   @id @default(cuid())
  employeeId   String
  payrollMonth DateTime @db.Date

  monthlySalary Decimal @db.Decimal(12, 2)

  grossPay Decimal @db.Decimal(12, 2)

  lateFine        Decimal @default(0) @db.Decimal(12, 2)
  advanceDeduction Decimal @default(0) @db.Decimal(12, 2)

  deductions Decimal @default(0) @db.Decimal(12, 2)
  netPay     Decimal @db.Decimal(12, 2)

  status PayrollStatus @default(PAID)

  paidAt    DateTime?
  createdAt DateTime @default(now())

  employee Employee @relation( fields: [employeeId], references: [id], onDelete: Restrict )

  salaryAdvances EmployeeSalaryAdvance[] @relation("PayrollAdvanceDeductions")
  branchId String 
  branch Branch @relation( fields: [branchId], references: [id], onDelete: Restrict )
  @@unique([employeeId, payrollMonth])
  @@index([payrollMonth, status])
}


enum EmployeeAttendanceStatus {
  PRESENT
  ABSENT
}

enum EmployeeAttendanceSource {
  BIOMETRIC
  MANUAL
}

model EmployeeAttendance {
  id String @id @default(cuid())

  employeeId String

  attendanceDate DateTime @db.Date

  status EmployeeAttendanceStatus

  source EmployeeAttendanceSource @default(BIOMETRIC)

  // Biometric data
  externalRecordId String?

  firstCheckInAt DateTime?
  lastCheckOutAt DateTime?

  // Snapshot calculated from the employee's shift.
  lateMinutes Int @default(0)
  lateFine    Decimal @default(0) @db.Decimal(12, 2)

  recordedById String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation( fields: [employeeId], references: [id], onDelete: Restrict )
  branchId String 
  branch Branch @relation( fields: [branchId], references: [id], onDelete: Restrict )
  recordedBy User? @relation( "EmployeeAttendanceRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict )

  @@unique([employeeId, attendanceDate])
  @@unique([externalRecordId])
  @@index([attendanceDate])
  @@index([employeeId, attendanceDate])
  @@index([status, attendanceDate])
}


enum SalaryAdvanceStatus {
  OPEN
  DEDUCTED
  CANCELLED
}

model EmployeeSalaryAdvance {
  id String @id @default(cuid())

  employeeId String

  amount Decimal @db.Decimal(12, 2)

  advanceDate DateTime @db.Date

  // Payroll month from which the advance should be deducted.
  deductionPayrollMonth DateTime? @db.Date

  status SalaryAdvanceStatus @default(OPEN)

  notes String?

  recordedById String

  recordedAt DateTime @default(now())

  deductedAt DateTime?

  deductedPayrollId String?

  employee Employee @relation( fields: [employeeId], references: [id], onDelete: Restrict )

  recordedBy User @relation( "SalaryAdvanceRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict )

  deductedPayroll PayrollEntry? @relation( "PayrollAdvanceDeductions", fields: [deductedPayrollId], references: [id], onDelete: SetNull )

  @@index([employeeId, status])
  @@index([deductionPayrollMonth])
  @@index([advanceDate])
}
// Reports releted tables and enums

enum OFFICEREPORTCHECKSTATUS {
  NA
  ISSUE
  OK
  NOT_CHECKED
}

model OfficeDailyReport {
  id           String   @id @default(cuid())
  reportDate   DateTime @db.Date
  generalNotes String?

  createdById String
  createdBy   User   @relation("OfficeReportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  checks OfficeDailyReportCheck[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reportDate])
  @@index([reportDate])
}

model OfficeDailyReportCheck {
  id String @id @default(cuid())

  itemKey          String
  category         String
  label            String
  status           OFFICEREPORTCHECKSTATUS @default(NOT_CHECKED)
  issueNote        String?
  actionTaken      String?
  followUpRequired Boolean                 @default(false)

  reportId String
  report   OfficeDailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, itemKey])
  @@index([reportId, status])
}


enum Country {
  INDIA
  UNITED_STATES
  CANADA
  UNITED_KINGDOM
  AUSTRALIA
  NEW_ZEALAND
  IRELAND
  GERMANY
  FRANCE
  ITALY
  SPAIN
  PORTUGAL
  POLAND
  NETHERLANDS
  BELGIUM
  SWITZERLAND
  SWEDEN
  NORWAY
  DENMARK
  FINLAND
  AUSTRIA
  CZECH_REPUBLIC
  HUNGARY
  ROMANIA
  JAPAN
  SOUTH_KOREA
  CHINA
  SINGAPORE
  MALAYSIA
  THAILAND
  UAE
  SAUDI_ARABIA
  QATAR
  OMAN
  KUWAIT
  BAHRAIN
  PAKISTAN
  BANGLADESH
  NEPAL
  SRI_LANKA
  AFGHANISTAN
  SOUTH_AFRICA
  NIGERIA
  KENYA
  GHANA
  EGYPT
