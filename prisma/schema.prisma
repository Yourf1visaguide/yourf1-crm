enum LeadSource {
  IVR
  WALK_IN
  WHATSAPP
  REFERRAL
  WEBSITE
  INSTAGRAM
  FACEBOOK
  PARTNER
  OTHER
}

enum LeadStatus {
  NEW
  TELECALLERASSIGNED

  // Telecalling outcomes
  NOT_PICKED
  NOT_INTERESTED
  INTERESTED
  JUST_INFO
  COUNSELORASSIGNED
  // Counselling outcomes
  COUNSELLING
  COLD
  CONVERTED
  REJECTED
}

enum LeadRejectionReason {
  FAKE
  DUPLICATE
  WRONG_NUMBER
  OUT_OF_SCOPE
  NOT_ELIGIBLE
  OTHER
}

enum ClientGender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  OTHER
}


enum LeadStatusChangeSource {
  USER
  SYSTEM
}

enum LeadAssignmentType{
  TELECALLING
  COUNSELLING
}

model Client {
  id         String @id @default(cuid())
  clientCode String @unique

  givenName  String?
  middleName String?
  surname    String?

  email              String?
  communicationEmail String?

  phone          String 
  normalizedPhone String @unique
  alternatePhone String?

  dateOfBirth   DateTime?      @db.Date
  gender        ClientGender?
  maritalStatus MaritalStatus?

  nationality Country?

  nationalId String?

  isPreviousVisaRefusal      Boolean @default(false)
  previousVisaRefusalDetails String?


  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  addresses        ClientAddress[]
  familyMembers    ClientFamilyMember[]
  educationRecords ClientEducation[]
  tests            ClientTest[]
  workExperiences  ClientWorkExperience[]
  passport         ClientPassport?
  leads            Lead[]
  applications     Application[]
  invoices         Invoice[]
  registrations    Registration[]
  financialEntries FinancialEntry[] @relation("FinancialEntryClient")
  whatsappConversations WhatsAppConversation[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

model Lead {
  id       String @id @default(cuid())
  leadCode String @unique

  source LeadSource
  status LeadStatus @default(NEW)

  rejectionReason LeadRejectionReason?

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments       LeadAssignment[]
  statusHistory     LeadStatusHistory[]
  registration      Registration?
  whatsappConversations WhatsAppConversation[]
  leadCallAttempts LeadCallAttempt[]
  leadVisits LeadVisit[]
  
  // Existing fields and relations
  originatedApplication Application? @relation("LeadOriginatingApplication")
  @@index([source])
  @@index([status])
  @@index([clientId])
  @@index([branchId])
}

model LeadStatusHistory {
  id String @id @default(cuid())

  leadId String
  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  fromStatus LeadStatus?
  toStatus   LeadStatus

  changedById String?
  changedBy   User? @relation( "LeadStatusHistoryChangedBy", fields: [changedById], references: [id], onDelete: Restrict )

  source LeadStatusChangeSource @default(USER)

  reason String?

  changedAt DateTime @default(now())

  @@index([leadId, changedAt])
  @@index([changedById])
  @@index([toStatus])
}

model LeadAssignment {
  id String @id @default(cuid())

  leadId       String
  assignedToId String
  assignedById String

  assignedAt DateTime  @default(now())
  endedAt    DateTime?

  note String?
  
  type LeadAssignmentType

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  assignedTo User @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)

  assignedBy User @relation("LeadAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  @@index([leadId, type])
  @@index([assignedToId, type])
  @@index([leadId, endedAt])
}

enum LeadCallOutcome {
  NOT_PICKED
  ANSWERED
  CALLBACK_REQUESTED
  INTERESTED
  NOT_INTERESTED
  JUST_INFO
  WRONG_NUMBER
  OTHER
}

model LeadCallAttempt {
  id String @id @default(cuid())

  leadId String
  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Restrict)

  attemptedById String
  attemptedBy   User @relation(fields: [attemptedById], references: [id], onDelete: Restrict)

  attemptedAt DateTime @default(now())
  outcome     LeadCallOutcome
  notes       String?

  createdAt DateTime @default(now())

  @@index([leadId, attemptedAt])
  @@index([attemptedById, attemptedAt])
  @@index([outcome, attemptedAt])
}

enum LeadVisitStatus {
  SCHEDULED
  CONFIRMED
  NOT_CONFIRMED
  COMPLETED
  MISSED
  CANCELLED
}


enum LeadVisitEventType {
  CREATED
  RESCHEDULED
  CONFIRMED
  NOT_CONFIRMED
  COMPLETED
  MISSED
  CANCELLED
  NOTE_ADDED
}

model LeadVisit {
  id String @id @default(cuid())

  leadId String
  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Restrict)

  promisedAt DateTime
  status     LeadVisitStatus @default(SCHEDULED)

  confirmationAt DateTime?
  actualVisitAt  DateTime?

  notes String?

  createdById String
  createdBy   User @relation( "LeadVisitCreatedBy", fields: [createdById], references: [id], onDelete: Restrict )

  events LeadVisitEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId, promisedAt])
  @@index([status, promisedAt])
}

model LeadVisitEvent {
  id String @id @default(cuid())

  visitId String
  visit   LeadVisit @relation(fields: [visitId], references: [id], onDelete: Restrict)

  eventType LeadVisitEventType

  previousPromisedAt DateTime?
  newPromisedAt      DateTime?

  previousStatus LeadVisitStatus?
  newStatus      LeadVisitStatus?

  note String?

  changedById String
  changedBy   User @relation( "LeadVisitEventChangedBy", fields: [changedById], references: [id], onDelete: Restrict )

  createdAt DateTime @default(now())

  @@index([visitId, createdAt])
  @@index([changedById, createdAt])
}
enum ClientAddressType {
  PERMANENT
  CURRENT
}

model ClientAddress {
  id       String @id @default(cuid())
  clientId String

  type ClientAddressType

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      Country?
  countryOther String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Only one CURRENT and one PERMANENT address per client.
  @@unique([clientId, type])
  @@index([clientId])
}

enum ClientFamilyRelationship {
  FATHER
  MOTHER
  SPOUSE
  CHILD
  SIBLING
}

model ClientFamilyMember {
  id String @id @default(cuid())

  clientId String

  relationship ClientFamilyRelationship

  name        String
  phone       String?
  email       String?
  dateOfBirth DateTime? @db.Date
  occupation  String?

  // Sensitive government identity information
  aadhaarUid String?

  address      String?
  otherDetails String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([clientId, relationship])
}

enum ClientEducationLevel {
  TENTH
  TWELFTH
  DIPLOMA
  BACHELOR
  MASTER
  DOCTORATE
  OTHER
}

model ClientEducation {
  id       String @id @default(cuid())
  clientId String

  level ClientEducationLevel

  institutionName String?
  boardUniversity String?
  qualification   String?
  stream          String?

  percentage   Decimal? @db.Decimal(5, 2)
  cgpa         Decimal? @db.Decimal(5, 2)
  medium       String?
  englishMarks Decimal? @db.Decimal(5, 2)

  passingYear Int?
  resultDate  DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([clientId, level])
}

enum ClientTestType {
  IELTS
  TOEFL
  PTE
  GRE
  GMAT
  SAT
  DUOLINGO
  OTHER
}

model ClientTest {
  id       String @id @default(cuid())
  clientId String

  testType ClientTestType
  testDate DateTime?      @db.Date

  // Overall / main score
  overallScore Decimal? @db.Decimal(6, 2)

  // English test components
  listening Decimal? @db.Decimal(6, 2)
  reading   Decimal? @db.Decimal(6, 2)
  writing   Decimal? @db.Decimal(6, 2)
  speaking  Decimal? @db.Decimal(6, 2)

  // GRE
  verbal            Decimal? @db.Decimal(6, 2)
  quantitative      Decimal? @db.Decimal(6, 2)
  analyticalWriting Decimal? @db.Decimal(6, 2)

  // SAT
  math                        Decimal? @db.Decimal(6, 2)
  evidenceBasedReadingWriting Decimal? @db.Decimal(6, 2)

  // For an uncommon test / manually entered result
  otherScore Decimal? @db.Decimal(6, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([clientId, testType])
}

model ClientWorkExperience {
  id       String @id @default(cuid())
  clientId String

  companyName String
  jobTitle    String

  currentlyWorking Boolean @default(false)

  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date

  salaryDescription String?
  otherDetails      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([clientId, startDate])
}

model ClientPassport {
  id       String @id @default(cuid())
  clientId String @unique

  passportNumber         String?
  nationality            Country?
  issueDate              DateTime? @db.Date
  issuePlace             String?
  expiryDate             DateTime? @db.Date
  birthPlace             String?
  previousPassportNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

enum ApplicationType {
  STUDY
  TOURIST
}

enum ApplicationStatus {
  INTAKE
  IN_PROGRESS
  READY_FOR_SUBMISSION
  SUBMITTED
  VISA_STAMPED
  CANCELLED
  DENIED
}

model Application {
  id              String          @id @default(cuid())
  applicationCode String          @unique
  clientId        String
  registrationId  String?
  type            ApplicationType

  preferredCountry       Country?
  preferredCourseType    String?
  otherCountry           String?
  preferredCourseName    String?
  targetUniversity       String?
  accommodation          String?
  notes                  String?
  preferredQualification String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status ApplicationStatus @default(INTAKE)

  submittedAt    DateTime?
  visaStampedAt  DateTime?

  applicationCredentials ApplicationCredential[]
  documents              ApplicationDocument[]
  invoices               Invoice[]
  postVisaTasks PostVisaTask[]
  financialEntries FinancialEntry[] @relation("FinancialEntryApplication")
  client                 Client                  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  registration           Registration?           @relation("ApplicationToRegistration", fields: [registrationId], references: [id], onDelete: SetNull)

  branchId String 
  branch Branch @relation( fields: [branchId], references: [id], onDelete: Restrict )
  originatingLeadId String? @unique 
  originatingLead   Lead?   @relation( "LeadOriginatingApplication", fields: [originatingLeadId], references: [id], onDelete: SetNull )
   teachingEnrollment TeachingEnrollment?
   touristPrep TouristPrep?

  @@index([clientId])
  @@index([registrationId])
  @@index([clientId, type])
}

enum ApplicationCredentialType {
  STUDENT_EMAIL
  STUDENT_EMAIL_PASSWORD

  VFS_PASSWORD
  VISA_FORM_PASSWORD

  CGI_USERNAME
  CGI_PASSWORD

  DS160_USERNAME
  DS160_PASSWORD

  EMAIL_2
  EMAIL_3

  OTHER
}

model ApplicationCredential {
  id            String @id @default(cuid())
  applicationId String

  type           ApplicationCredentialType
  valueEncrypted String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, type])
  @@index([applicationId])
}

enum RegistrationStatus {
  ACTIVE
  CANCELLED
}

model Registration {
  id               String @id @default(cuid())
  registrationCode String @unique

  leadId         String             @unique
  clientId       String
  status         RegistrationStatus @default(ACTIVE)
  registeredById String
  registeredAt   DateTime           @default(now())

  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Restrict)

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  registeredBy User @relation("RegistrationCreatedBy", fields: [registeredById], references: [id], onDelete: Restrict)

