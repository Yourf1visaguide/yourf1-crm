enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationSurface {
  BELL
  DASHBOARD
  SIDEBAR
  DEPARTMENTPAGE
}

model Notification {
  id String @id @default(cuid())

  userId String

  priority NotificationPriority @default(NORMAL)

