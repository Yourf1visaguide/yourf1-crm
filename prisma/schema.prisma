// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DEPARTMENT {
  ADMIN
  PARTNER
  RECEPTION
  TELECALLING
  COUNSELLING
  FILING
  TEACHING
  FINANCE
  MARKETING
  HR
}

enum ROLES {
  ADMIN
  RECEPTION
  TELECALLER
  COUNSELOR
  TEACHER
  FILING
  FINANCE
  MARKETING
  HR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}



model User {
  id       String  @id @default(cuid())
  email    String  @unique
  isActive Boolean @default(true)
  roles     ROLES[] @default([])

  employee      Employee?
  name          String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  username      String?
  sessions      Session[]
  accounts      Account[]
  officeReportsCreated OfficeDailyReport[] @relation("OfficeReportCreatedBy")
  @@unique([username])
  @@map("user")
}


model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Employee {
  id               String     @id @default(cuid())
  employeeCode     String     @unique
  department       DEPARTMENT
  designation      String?
  joiningDate      DateTime   @db.Date
  employmentStatus EmploymentStatus @default(ACTIVE)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  compensation   EmployeeCompensation[]
  schedules      EmployeeWorkSchedule[]
  payrollEntries PayrollEntry[]
}

model EmployeeCompensation {
  id            String    @id @default(cuid())
  employeeId    String
  monthlySalary Decimal   @db.Decimal(12, 2)
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, effectiveFrom])
}

model EmployeeWorkSchedule {
  id            String    @id @default(cuid())
  employeeId    String
  startTime     String
  endTime       String
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, effectiveFrom])
}

// employe salary calculation table.

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

model PayrollEntry {
  id           String   @id @default(cuid())
  employeeId   String
  payrollMonth DateTime @db.Date

  // Snapshot of the salary rate used for this payroll.
  monthlySalary Decimal @db.Decimal(12, 2)

  grossPay   Decimal @db.Decimal(12, 2)
  deductions Decimal @default(0) @db.Decimal(12, 2)
  netPay     Decimal @db.Decimal(12, 2)

  status    PayrollStatus @default(PAID)
  paidAt    DateTime?
  createdAt DateTime      @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, payrollMonth])
  @@index([payrollMonth, status])
}


// Reports releted tables and enums


enum OFFICEREPORTCHECKSTATUS {
  NA
  ISSUE
  OK
  NOT_CHECKED  
}
model OfficeDailyReport {
  id           String   @id @default(cuid())
  reportDate   DateTime @db.Date
  generalNotes String?

  createdById String
  createdBy   User   @relation("OfficeReportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  checks OfficeDailyReportCheck[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reportDate])
  @@index([reportDate])
}

model OfficeDailyReportCheck {
  id String @id @default(cuid())

  itemKey          String
  category         String
  label            String
  status           OFFICEREPORTCHECKSTATUS @default(NOT_CHECKED)
  issueNote        String?
  actionTaken      String?
  followUpRequired Boolean @default(false)

  reportId String
  report   OfficeDailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, itemKey])
  @@index([reportId, status])
}



enum ClientGender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  OTHER
}

enum Country {
  INDIA
  UNITED_STATES
  CANADA
  UNITED_KINGDOM
  AUSTRALIA
  NEW_ZEALAND
  IRELAND
  GERMANY
  FRANCE
  ITALY
  SPAIN
  PORTUGAL
  POLAND
  NETHERLANDS
  BELGIUM
  SWITZERLAND
  SWEDEN
  NORWAY
  DENMARK
  FINLAND
  AUSTRIA
  CZECH_REPUBLIC
  HUNGARY
  ROMANIA
  JAPAN
  SOUTH_KOREA
  CHINA
  SINGAPORE
  MALAYSIA
  THAILAND
  UAE
  SAUDI_ARABIA
  QATAR
  OMAN
  KUWAIT
  BAHRAIN
  PAKISTAN
  BANGLADESH
  NEPAL
  SRI_LANKA
  AFGHANISTAN
  SOUTH_AFRICA
  NIGERIA
  KENYA
  GHANA
  EGYPT
  BRAZIL
  MEXICO
  ARGENTINA
  CHILE
  OTHER
}
model Client {
  id                  String   @id @default(cuid())
  clientCode          String   @unique

  givenName           String
  middleName          String?
  surname             String?

  email               String?
  communicationEmail  String?

  phone               String
  alternatePhone      String?

  dateOfBirth         DateTime? @db.Date
  gender              ClientGender?
  maritalStatus       MaritalStatus?

  nationality         Country

  nationalId          String?

  addresses ClientAddress[]
  familyMembers ClientFamilyMember[]
  educationRecords ClientEducation[]
  tests ClientTest[]
  workExperiences ClientWorkExperience[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}



enum ClientAddressType {
  PERMANENT
  CURRENT
}

model ClientAddress {
  id            String            @id @default(cuid())
  clientId      String

  type          ClientAddressType

  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  postalCode    String?
  country       Country
  countryOther  String?

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  client        Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Only one CURRENT and one PERMANENT address per client.
  @@unique([clientId, type])
  @@index([clientId])
}


enum ClientFamilyRelationship {
  FATHER
  MOTHER
  SPOUSE
  CHILD
  SIBLING
}

model ClientFamilyMember {
  id String @id @default(cuid())

  clientId String

  relationship ClientFamilyRelationship

  name         String
  phone        String?
  email        String?
  dateOfBirth  DateTime? @db.Date
  occupation   String?

  // Sensitive government identity information
  aadhaarUid   String?

  address      String?
  otherDetails String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation( fields: [clientId], references: [id], onDelete: Cascade )

  @@index([clientId])
  @@index([clientId, relationship])
}

enum ClientEducationLevel {
  TENTH
  TWELFTH
  DIPLOMA
  BACHELOR
  MASTER
  DOCTORATE
  OTHER
}

model ClientEducation {
  id       String @id @default(cuid())
  clientId String

  level ClientEducationLevel

  institutionName String?
  boardUniversity String?
  qualification   String?
  stream          String?

  percentage   Decimal? @db.Decimal(5, 2)
  cgpa         Decimal? @db.Decimal(5, 2)
  medium       String?
  englishMarks Decimal? @db.Decimal(5, 2)

  passingYear Int?
  resultDate  DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation( fields: [clientId], references: [id], onDelete: Cascade )

  @@index([clientId])
  @@index([clientId, level])
}


enum ClientTestType {
  IELTS
  TOEFL
  PTE
  GRE
  GMAT
  SAT
  DUOLINGO
  OTHER
}

model ClientTest {
  id       String @id @default(cuid())
  clientId String

  testType ClientTestType
  testDate DateTime? @db.Date

  // Overall / main score
  overallScore Decimal? @db.Decimal(6, 2)

  // English test components
  listening Decimal? @db.Decimal(6, 2)
  reading   Decimal? @db.Decimal(6, 2)
  writing   Decimal? @db.Decimal(6, 2)
  speaking  Decimal? @db.Decimal(6, 2)

  // GRE
  verbal           Decimal? @db.Decimal(6, 2)
  quantitative     Decimal? @db.Decimal(6, 2)
  analyticalWriting Decimal? @db.Decimal(6, 2)

  // SAT
  math                       Decimal? @db.Decimal(6, 2)
  evidenceBasedReadingWriting Decimal? @db.Decimal(6, 2)

  // For an uncommon test / manually entered result
  otherScore Decimal? @db.Decimal(6, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation( fields: [clientId], references: [id], onDelete: Cascade )

  @@index([clientId])
  @@index([clientId, testType])
}


model ClientWorkExperience {
  id       String @id @default(cuid())
  clientId String

  companyName String
  jobTitle    String

  currentlyWorking Boolean @default(false)

  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date

  salaryDescription String?
  otherDetails     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation( fields: [clientId], references: [id], onDelete: Cascade )

  @@index([clientId])
  @@index([clientId, startDate])
}