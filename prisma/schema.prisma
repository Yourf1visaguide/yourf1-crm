// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DEPARTMENT {
  ADMIN
  PARTNER
  RECEPTION
  TELECALLING
  COUNSELLING
  FILING
  TEACHING
  FINANCE
  MARKETING
  HR
}

enum ROLES {
  ADMIN
  RECEPTION
  TELECALLER
  COUNSELOR
  TEACHER
  FILING
  FINANCE
  MARKETING
  HR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}



model User {
  id       String  @id @default(cuid())
  email    String  @unique
  isActive Boolean @default(true)
  roles     ROLES[] @default([])

  employee      Employee?
  name          String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  username      String?
  sessions      Session[]
  accounts      Account[]
  officeReportsCreated OfficeDailyReport[] @relation("OfficeReportCreatedBy")
  
  leadAssignedTo LeadAssignment[] @relation("LeadAssignedTo")
  leadAssignedBy LeadAssignment[] @relation("LeadAssignedBy")
  registeration Registration? @relation("RegistrationCreatedBy")
  @@unique([username])
  @@map("user")
}


model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Employee {
  id               String     @id @default(cuid())
  employeeCode     String     @unique
  department       DEPARTMENT
  designation      String?
  joiningDate      DateTime   @db.Date
  employmentStatus EmploymentStatus @default(ACTIVE)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  compensation   EmployeeCompensation[]
  schedules      EmployeeWorkSchedule[]
  payrollEntries PayrollEntry[]
}

model EmployeeCompensation {
  id            String    @id @default(cuid())
  employeeId    String
  monthlySalary Decimal   @db.Decimal(12, 2)
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, effectiveFrom])
}

model EmployeeWorkSchedule {
  id            String    @id @default(cuid())
  employeeId    String
  startTime     String
  endTime       String
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, effectiveFrom])
}

// employe salary calculation table.

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

model PayrollEntry {
  id           String   @id @default(cuid())
  employeeId   String
  payrollMonth DateTime @db.Date

  // Snapshot of the salary rate used for this payroll.
  monthlySalary Decimal @db.Decimal(12, 2)

  grossPay   Decimal @db.Decimal(12, 2)
  deductions Decimal @default(0) @db.Decimal(12, 2)
  netPay     Decimal @db.Decimal(12, 2)

  status    PayrollStatus @default(PAID)
  paidAt    DateTime?
  createdAt DateTime      @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, payrollMonth])
  @@index([payrollMonth, status])
}


// Reports releted tables and enums


enum OFFICEREPORTCHECKSTATUS {
  NA
  ISSUE
  OK
  NOT_CHECKED  
}
model OfficeDailyReport {
  id           String   @id @default(cuid())
  reportDate   DateTime @db.Date
  generalNotes String?

  createdById String
  createdBy   User   @relation("OfficeReportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  checks OfficeDailyReportCheck[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reportDate])
  @@index([reportDate])
}

model OfficeDailyReportCheck {
  id String @id @default(cuid())

  itemKey          String
  category         String
  label            String
  status           OFFICEREPORTCHECKSTATUS @default(NOT_CHECKED)
  issueNote        String?
  actionTaken      String?
  followUpRequired Boolean @default(false)

  reportId String
  report   OfficeDailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, itemKey])
  @@index([reportId, status])
}

enum LeadSource {
  IVR
  WALK_IN
  WHATSAPP
  REFERRAL
  WEBSITE
  INSTAGRAM
  FACEBOOK
  PARTNER
  OTHER
}

enum LeadStatus {
  NEW
  NOT_PICKED
  NOT_INTERESTED
  JUST_INFO
  CONVERTED
}

model Lead {
  id       String     @id @default(cuid())
  leadCode String     @unique

  source   LeadSource
  status   LeadStatus @default(NEW)

  clientId String
  client   Client @relation( fields: [clientId], references: [id], onDelete: Restrict )

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments LeadAssignment[]
  registeration Registration?
  @@index([source])
  @@index([status])
  @@index([clientId])
}

model LeadAssignment {
  id String @id @default(cuid())

  leadId       String
  assignedToId String
  assignedById String

  assignedAt   DateTime  @default(now())
  endedAt      DateTime?

  note String?

  lead Lead @relation( fields: [leadId], references: [id], onDelete: Cascade )

  assignedTo User @relation( "LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict )

  assignedBy User @relation( "LeadAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict )

  @@index([leadId])
  @@index([assignedToId])
  @@index([leadId, endedAt])
}

enum ClientGender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  OTHER
}

enum Country {
  INDIA
  UNITED_STATES
  CANADA
  UNITED_KINGDOM
  AUSTRALIA
  NEW_ZEALAND
  IRELAND
  GERMANY
  FRANCE
  ITALY
  SPAIN
  PORTUGAL
  POLAND
  NETHERLANDS
  BELGIUM
  SWITZERLAND
  SWEDEN
  NORWAY
  DENMARK
  FINLAND
  AUSTRIA
  CZECH_REPUBLIC
  HUNGARY
  ROMANIA
  JAPAN
  SOUTH_KOREA
  CHINA
  SINGAPORE
  MALAYSIA
  THAILAND
  UAE
  SAUDI_ARABIA
  QATAR
  OMAN
  KUWAIT
  BAHRAIN
  PAKISTAN
  BANGLADESH
  NEPAL
  SRI_LANKA
  AFGHANISTAN
  SOUTH_AFRICA
  NIGERIA
  KENYA
  GHANA
  EGYPT
  BRAZIL
  MEXICO
  ARGENTINA
  CHILE
  OTHER
}

model Client {
  id                  String   @id @default(cuid())
  clientCode          String   @unique

  givenName           String?
  middleName          String?
  surname             String?

  email               String?
  communicationEmail  String?

  phone               String?
  alternatePhone      String?

  dateOfBirth         DateTime? @db.Date
  gender              ClientGender?
  maritalStatus       MaritalStatus?

  nationality         Country?

  nationalId          String?

  isPreviousVisaRefusal     Boolean? @default(false)
  previousVisaRefusalDetails String?

  addresses ClientAddress[]
  familyMembers ClientFamilyMember[]
  educationRecords ClientEducation[]
  tests ClientTest[]
  workExperiences ClientWorkExperience[]
  passport ClientPassport?
  leads            Lead[]
  applications     Application[]
  registeration Registration?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}



enum ClientAddressType {
  PERMANENT
  CURRENT
}

model ClientAddress {
  id            String            @id @default(cuid())
  clientId      String

  type          ClientAddressType

  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  postalCode    String?
  country       Country
  countryOther  String?

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  client        Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Only one CURRENT and one PERMANENT address per client.
  @@unique([clientId, type])
  @@index([clientId])
}


enum ClientFamilyRelationship {
  FATHER
  MOTHER
  SPOUSE
  CHILD
  SIBLING
}

model ClientFamilyMember {
  id String @id @default(cuid())

  clientId String

  relationship ClientFamilyRelationship

  name         String
  phone        String?
  email        String?
  dateOfBirth  DateTime? @db.Date
  occupation   String?

  // Sensitive government identity information
  aadhaarUid   String?

  address      String?
  otherDetails String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation( fields: [clientId], references: [id], onDelete: Cascade )

  @@index([clientId])
  @@index([clientId, relationship])
}

enum ClientEducationLevel {
  TENTH
  TWELFTH
  DIPLOMA
  BACHELOR
  MASTER
  DOCTORATE
  OTHER
}

model ClientEducation {
  id       String @id @default(cuid())
  clientId String

  level ClientEducationLevel

  institutionName String?
  boardUniversity String?
  qualification   String?
  stream          String?

  percentage   Decimal? @db.Decimal(5, 2)
  cgpa         Decimal? @db.Decimal(5, 2)
  medium       String?
  englishMarks Decimal? @db.Decimal(5, 2)

  passingYear Int?
  resultDate  DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation( fields: [clientId], references: [id], onDelete: Cascade )

  @@index([clientId])
  @@index([clientId, level])
}


enum ClientTestType {
  IELTS
  TOEFL
  PTE
  GRE
  GMAT
  SAT
  DUOLINGO
  OTHER
}

model ClientTest {
  id       String @id @default(cuid())
  clientId String

  testType ClientTestType
  testDate DateTime? @db.Date

  // Overall / main score
  overallScore Decimal? @db.Decimal(6, 2)

  // English test components
  listening Decimal? @db.Decimal(6, 2)
  reading   Decimal? @db.Decimal(6, 2)
  writing   Decimal? @db.Decimal(6, 2)
  speaking  Decimal? @db.Decimal(6, 2)

  // GRE
  verbal           Decimal? @db.Decimal(6, 2)
  quantitative     Decimal? @db.Decimal(6, 2)
  analyticalWriting Decimal? @db.Decimal(6, 2)

  // SAT
  math                       Decimal? @db.Decimal(6, 2)
  evidenceBasedReadingWriting Decimal? @db.Decimal(6, 2)

  // For an uncommon test / manually entered result
  otherScore Decimal? @db.Decimal(6, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation( fields: [clientId], references: [id], onDelete: Cascade )

  @@index([clientId])
  @@index([clientId, testType])
}


model ClientWorkExperience {
  id       String @id @default(cuid())
  clientId String

  companyName String
  jobTitle    String

  currentlyWorking Boolean @default(false)

  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date

  salaryDescription String?
  otherDetails     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation( fields: [clientId], references: [id], onDelete: Cascade )

  @@index([clientId])
  @@index([clientId, startDate])
}

model ClientPassport {
  id       String @id @default(cuid())
  clientId String @unique

  passportNumber    String?
  nationality       Country?
  issueDate         DateTime? @db.Date
  issuePlace        String?
  expiryDate        DateTime? @db.Date
  birthPlace        String?
  previousPassportNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation( fields: [clientId], references: [id], onDelete: Cascade )
}



enum ApplicationType {
  STUDY
  TOURIST
}

model Application {
  id       String @id @default(cuid())
  applicationCode String @unique
  clientId String
  registrationId String?
  type ApplicationType

  preferredCountry     Country?
  otherCountry         String?
  preferredCourseType  String?
  preferredCourseName  String?
  targetUniversity     String?
  accommodation        String?
  notes                String?


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  applicationCredentials ApplicationCredential[]
  documents   ApplicationDocument[]
  invoices    Invoice[]
  registration Registration? @relation( fields: [registrationId], references: [id], onDelete: SetNull )
  client Client @relation( fields: [clientId], references: [id], onDelete: Restrict )

  @@index([clientId])
  @@index([clientId, type])
}

enum ApplicationCredentialType {
  STUDENT_EMAIL
  STUDENT_EMAIL_PASSWORD

  VFS_PASSWORD
  VISA_FORM_PASSWORD

  CGI_USERNAME
  CGI_PASSWORD

  DS160_USERNAME
  DS160_PASSWORD

  EMAIL_2
  EMAIL_3

  OTHER
}

model ApplicationCredential {
  id            String @id @default(cuid())
  applicationId String

  type           ApplicationCredentialType
  valueEncrypted String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application @relation( fields: [applicationId], references: [id], onDelete: Cascade )

  @@unique([applicationId, type])
  @@index([applicationId])
}

enum RegistrationStatus {
  ACTIVE
  CANCELLED
}

model Registration {
  id               String   @id @default(cuid())
  registrationCode String   @unique

  leadId        String  @unique
  clientId      String
  applicationId String
  status RegistrationStatus @default(ACTIVE)
  registeredById String
  registeredAt   DateTime @default(now())

  cancelledAt DateTime?
  cancelledById     String?
  cancellationReason String?

  lead        Lead        @relation(fields: [leadId], references: [id], onDelete: Restrict)
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  cancelledBy User? @relation( "RegistrationCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict )
  registeredBy User @relation("RegistrationCreatedBy", fields: [registeredById], references: [id], onDelete: Restrict )

  commissions CommissionEntry[]

  @@index([clientId])
  @@index([applicationId])
  @@index([registeredAt])
}
enum CommissionType {
  COUNSELOR_REGISTRATION
  TELECALLER_REGISTRATION
}

enum CommissionStatus {
  EARNED
  REVERSED
  PAID
}

model CommissionEntry {
  id String @id @default(cuid())

  registrationId String
  employeeId     String?

  type   CommissionType
  amount Decimal @db.Decimal(12, 2)
  status CommissionStatus @default(EARNED)

  earnedAt   DateTime  @default(now())
  reversedAt DateTime?
  paidAt     DateTime?

  registration Registration @relation( fields: [registrationId], references: [id], onDelete: Restrict )

  employee Employee? @relation( fields: [employeeId], references: [id], onDelete: Restrict )

  @@unique([registrationId, type])
  @@index([registrationId])
  @@index([employeeId])
  @@index([employeeId, status])
}
enum TaskType {
  LEAD_FOLLOW_UP
  DOCUMENT_FOLLOW_UP
  TEACHING_URGENT_PREP
  PAYMENT_COLLECTION
  OTHER
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Task {
  id String @id @default(cuid())

  type     TaskType
  status   TaskStatus   @default(OPEN)
  priority TaskPriority @default(NORMAL)

  title       String
  description String?

  assigneeId String
  createdById String?

  dueAt       DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  // Generic link to the business object.
  entityType String?
  entityId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignee User @relation( "TaskAssignedTo", fields: [assigneeId], references: [id], onDelete: Restrict )

  createdBy User? @relation( "TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict )

  notifications Notification[]

  @@index([assigneeId, status])
  @@index([assigneeId, dueAt])
  @@index([entityType, entityId])
}
enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationSurface {
  BELL
  DASHBOARD
  SIDEBAR
}

model Notification {
  id String @id @default(cuid())

  userId String

  priority NotificationPriority @default(NORMAL)

  // Where this notification should appear.
  surfaces NotificationSurface[] @default([BELL])

  type String

  title   String
  message String

  entityType String?
  entityId   String?

  taskId String?

  readAt        DateTime?
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  resolvedById String?

  createdAt DateTime @default(now())

  user User @relation( fields: [userId], references: [id], onDelete: Cascade )

  task Task? @relation( fields: [taskId], references: [id], onDelete: SetNull )

  resolvedBy User? @relation( "NotificationResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict )

  @@index([userId, readAt])
  @@index([userId, resolvedAt])
  @@index([userId, priority])
  @@index([createdAt])
}


model AuditLog {
  id String @id @default(cuid())

  actorId String?

  action     String
  entityType String
  entityId   String

  metadata Json?

  createdAt DateTime @default(now())

  actor User? @relation( fields: [actorId], references: [id], onDelete: SetNull )

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}


model DocumentRequirement {
  id String @id @default(cuid())

  key         String @unique
  name        String
  description String?
  purpose     String?

  applicationType ApplicationType?
  country         Country?

  reminderEveryDays Int @default(5)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationDocuments ApplicationDocument[]
}

enum ApplicationDocumentStatus {
  PENDING
  MISSING
  RECEIVED
  VERIFIED
  NOT_REQUIRED
}

model ApplicationDocument {
  id            String @id @default(cuid())
  applicationId String

  requirementId String?

  documentKey String
  name        String
  description String?
  purpose     String?

  status ApplicationDocumentStatus @default(PENDING)

  // Reminder configuration copied from DocumentRequirement
  reminderEveryDays Int

  // Reminder tracking
  trackingStartedAt DateTime @default(now())
  lastReminderAt    DateTime?
  nextReminderAt    DateTime?

  // "Other" document explanation
  otherDetails String?

  // Current uploaded file
  storageKey String?
  fileName   String?
  mimeType   String?
  sizeBytes  Int?
  checksum   String?

  uploadedById String?
  uploadedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application @relation( fields: [applicationId], references: [id], onDelete: Cascade )

  requirement DocumentRequirement? @relation( fields: [requirementId], references: [id], onDelete: SetNull )

  uploadedBy User? @relation( "ApplicationDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict )

  @@index([applicationId])
  @@index([applicationId, status])
  @@index([nextReminderAt])
}


enum InvoiceType {
  REGISTRATION
  POST_VISA_SERVICE
}

enum InvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
}


model Invoice {
  id            String @id @default(cuid())
  invoiceNumber String @unique

  clientId       String
  registrationId String?
  applicationId  String?

  type   InvoiceType
  status InvoiceStatus @default(ISSUED)

  issuedAt DateTime @default(now())
  subtotal Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation( fields: [clientId], references: [id], onDelete: Restrict )

  registration Registration? @relation( fields: [registrationId], references: [id], onDelete: Restrict )

  application Application? @relation( fields: [applicationId], references: [id], onDelete: Restrict )

  payments Payment[]
  refunds  Refund[]

  @@index([clientId])
  @@index([registrationId])
  @@index([applicationId])
  @@index([status])
}


enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  CHEQUE
  OTHER
}

enum PaymentStatus {
  CONFIRMED
  VOIDED
}

model Payment {
  id String @id @default(cuid())

  invoiceId String

  // Amount applied against the actual invoice.
  baseAmount Decimal @db.Decimal(12, 2)

  // GST charged on this particular payment.
  gstRate   Decimal @default(0) @db.Decimal(5, 2)
  gstAmount Decimal @default(0) @db.Decimal(12, 2)

  // What the client actually paid.
  totalAmount Decimal @db.Decimal(12, 2)

  method PaymentMethod
  status PaymentStatus @default(CONFIRMED)

  reference String?

  receivedAt   DateTime @default(now())
  receivedById String

  notes String?

  invoice Invoice @relation( fields: [invoiceId], references: [id], onDelete: Restrict )

  receivedBy User @relation( "PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict )

  refunds Refund[]

  @@index([invoiceId])
  @@index([receivedAt])
}

model Refund {
  id            String   @id @default(cuid())

  invoiceId     String
  amount        Decimal  @db.Decimal(12, 2)
  reason        String?
  refundedAt    DateTime @default(now())
  refundedById  String

  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  refundedBy    User     @relation("RefundProcessedBy", fields: [refundedById], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([refundedById])
  @@index([refundedAt])
}